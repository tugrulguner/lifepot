{
  "name": "lifepot",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "predev": "node scripts/embed-learn-guides.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/embed-learn-guides.mjs",
    "build": "next build",
    "render:wordmark": "node scripts/render-wordmark.mjs",
    "start": "next start",
    "lint": "eslint .",
    "pretypecheck": "node scripts/embed-learn-guides.mjs",
    "typecheck": "tsc --noEmit",
    "pretest": "node scripts/embed-learn-guides.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:cloudflare": "node scripts/check-worker-delivery.mjs",
    "build:cloudflare": "opennextjs-cloudflare build && node scripts/prepare-worker-delivery.mjs",
    "preview:cloudflare": "npm run build:cloudflare && opennextjs-cloudflare preview",
    "deploy:cloudflare": "npm run build:cloudflare && opennextjs-cloudflare deploy"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "@typesafe-ai/sdk": "^0.6.0",
    "next": "^16.4.3",
    "posthog-js": "^1.435.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.13",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "0.28.1",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.3.5",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^27.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "vitest": "^5.0.3",
    "wrangler": "^4.154.0"
  },
  "overrides": {
    "@node-minify/core@9.0.2": {
      "glob": "^10.5.0"
    }
  }
}
