{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lifepot-site",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-28",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "ratelimits": [
    {
      "name": "JUDGE_RATE_LIMIT",
      "namespace_id": "694200001",
      "simple": {
        "limit": 60,
        "period": 60
      }
    },
    {
      "name": "JUDGE_GLOBAL_RATE_LIMIT",
      "namespace_id": "694200002",
      "simple": {
        "limit": 240,
        "period": 60
      }
    }
  ],
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "lifepot-site"
    }
  ],
  "routes": [
    {
      "pattern": "lifepot.modepot.io",
      "custom_domain": true
    }
  ]
}
